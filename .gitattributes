# Auto-detect text files and normalise line endings to LF on checkout.
* text=auto eol=lf

# Ensure these are always treated as text with LF endings.
*.cs text eol=lf
*.csproj text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sln text eol=lf
*.slnx text eol=lf

# Binary files — no normalisation.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
